# 统一行尾，避免跨平台协作时整文件 diff
* text=auto eol=lf

# Windows 脚本必须 CRLF，否则部分环境下无法执行
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制，不做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.docx binary
*.xlsx binary
*.pptx binary
*.zip binary
*.onnx binary

# 语言与生成的文档
*.py text diff=python
*.md text
*.json text
*.yml text
*.yaml text
*.toml text
*.txt text

# 第三方代码不计入语言统计
scripts/_kit.py linguist-language=Python
